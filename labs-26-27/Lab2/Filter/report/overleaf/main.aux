\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Simulink model of the filter (simulation version). The model has four blocks: \texttt  {KalmanBucy} computes $\dot  {\hat  {\boldsymbol  {x}}}$ and $\dot  P$ from \eqref  {eq:riccati}, the integrators \texttt  {Int\_x} and \texttt  {Int\_P} close the loop, and \texttt  {Attitude} applies \eqref  {eq:angles}. In simulation, \texttt  {Truth} generates the exact roll, pitch and sensor readings, and \texttt  {Noise} and \texttt  {Bias} corrupt them. In replay, \texttt  {Truth}, \texttt  {Noise} and \texttt  {Bias} are replaced by the recorded data, and the onboard estimator of the drone is used as reference.}}{4}{figure.caption.9}\protected@file@percent }
\newlabel{fig:sim_model}{{5}{4}{Simulink model of the filter (simulation version). The model has four blocks: \texttt {KalmanBucy} computes $\dot {\hatx }$ and $\dot P$ from \eqref {eq:riccati}, the integrators \texttt {Int\_x} and \texttt {Int\_P} close the loop, and \texttt {Attitude} applies \eqref {eq:angles}. In simulation, \texttt {Truth} generates the exact roll, pitch and sensor readings, and \texttt {Noise} and \texttt {Bias} corrupt them. In replay, \texttt {Truth}, \texttt {Noise} and \texttt {Bias} are replaced by the recorded data, and the onboard estimator of the drone is used as reference}{figure.caption.9}{}}
