%% Lab 2 - Section 3: sensor characterization (tasks 3.1 - 3.4)

clear; close all; clc;

g = 9.81;

%% Experiments and analysis windows [s] (see LAB_NOTES.md)
%        name  file                            t_start  t_end
exps = { 'A', 'data/dados_alinea_A.mat',   1.0,  31.0;   % at rest, motors off
         'B', 'data/dados_alinea_B.mat',  16.2,  33.5;   % held down, full throttle
         'C', 'data/dados_alinea_C.mat',  10.1,  37.4 }; % hover, no takeoff/landing

lpf_on = false;   % optional low-pass on accelerometers before the inclinometer
lpf_fc = 10;      % cutoff [Hz]
fs     = 200;     % navdata rate [Hz]

names = {'ax','ay','az','gx','gy','gz'};
res = struct();

for e = 1:size(exps,1) 
    tag = exps{e,1};
    S = load(exps{e,2}, 'navdata');
    t = S.navdata.time(:);
    raw = S.navdata.signals.values;                 % N x 2186 uint8

    [accs, gyros] = decode_phys(raw);               % mg, deg/s

    idx = t >= exps{e,3} & t <= exps{e,4};
    acc  = accs(idx,:)  * g/1000;                   % m/s^2
    gyro = gyros(idx,:) * pi/180;                   % rad/s
    X = [acc gyro];

    % 3.1-3.3: mean and covariance
    mu = mean(X);
    C  = cov(X);
    sd = sqrt(diag(C))';
    R  = corrcoef(X);
    bias_az = mu(3) - (-g);                         % az at rest is -g, not bias

    % 3.4: raw inclinometer
    a = acc;
    if lpf_on
        [b_, a_] = butter(2, lpf_fc/(fs/2));
        a = filtfilt(b_, a_, a);
    end
    theta_acc = asin(max(min(a(:,1)/g, 1), -1));    % pitch [rad]
    phi_acc   = atan2(a(:,2), a(:,3));              % roll  [rad]

    res.(tag) = struct('mu',mu,'C',C,'sd',sd,'R',R,'bias_az',bias_az, ...
        'theta_mean',mean(theta_acc),'theta_std',std(theta_acc), ...
        'phi_mean',mean(phi_acc),'phi_std',std(phi_acc));

    fprintf('\n=== Experiment %s  (%.1f-%.1f s, N=%d) ===\n', tag, exps{e,3}, exps{e,4}, nnz(idx));
    fprintf('%-4s %12s %12s\n', 'sig', 'mean', 'std');
    for i = 1:6
        fprintf('%-4s %12.5f %12.5f\n', names{i}, mu(i), sd(i));
    end
    fprintf('az bias (mean + g): %.5f m/s^2\n', bias_az);
    disp('Covariance (6x6):');  disp(C);
    disp('Correlation (6x6):'); disp(R);
    fprintf('pitch_acc: mean %.3f deg, std %.3f deg\n', rad2deg(mean(theta_acc)), rad2deg(std(theta_acc)));
    fprintf('roll_acc : mean %.3f deg, std %.3f deg\n', rad2deg(mean(phi_acc)),   rad2deg(std(phi_acc)));

    % Histograms (Gaussianity)
    figure('Name', ['Histograms ' tag]);
    for i = 1:6
        subplot(2,3,i); histogram(X(:,i), 40, 'Normalization', 'pdf');
        title([names{i} ' (' tag ')']); grid on;
    end

    % Inclinometer time series
    figure('Name', ['Inclinometer ' tag]);
    subplot(2,1,1); plot(t(idx), rad2deg(theta_acc)); ylabel('\theta_{acc} [deg]'); grid on; title(['Experiment ' tag]);
    subplot(2,1,2); plot(t(idx), rad2deg(phi_acc));   ylabel('\phi_{acc} [deg]');   xlabel('t [s]'); grid on;
end

save('sensor_characterization_results.mat', 'res');

%% Function to obtain the values of the raw measurements. 
function [accs, gyros] = decode_phys(raw)
    N = size(raw,1);
    accs = nan(N,3);  gyros = nan(N,3);
    for k = 1:N
        row = raw(k,:);
        pos = 13;                                   % options start at byte 12 (1-based 13)
        while pos + 3 <= numel(row)
            tg = double(typecast(row(pos:pos+1),   'uint16'));
            sz = double(typecast(row(pos+2:pos+3), 'uint16'));
            if sz < 4, break; end
            if tg == 3                              % phys_measures (46 B)
                b = pos + 4;                        % body start
                accs(k,:)  = double(typecast(row(b+6  : b+17), 'single'));  % mg
                gyros(k,:) = double(typecast(row(b+18 : b+29), 'single'));  % deg/s
                break;
            end
            pos = pos + sz;
        end
    end
    ok = ~any(isnan([accs gyros]),2);               % drop empty startup packets
    accs(~ok,:) = 0;  gyros(~ok,:) = 0;
end
